{
  "name": "vscode-wp-block-html",
  "publisher": "co6x0",
  "version": "0.2.2",
  "license": "MIT",
  "icon": "images/icon.png",
  "displayName": "WP Block HTML",
  "description": "Assist coding for unique HTML used in WordPress Block Theme.",
  "author": "Nao Komura",
  "categories": [
    "Formatters",
    "Themes",
    "Snippets"
  ],
  "keywords": [
    "wordpress",
    "html",
    "vscode"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/co6x0/vscode-wp-block-html.git"
  },
  "bugs": {
    "url": "https://github.com/co6x0/vscode-wp-block-html/issues"
  },
  "main": "./out/extension.js",
  "engines": {
    "vscode": "^1.120.0"
  },
  "activationEvents": [
    "onLanguage:html"
  ],
  "contributes": {
    "languages": [
      {
        "id": "html",
        "aliases": [
          "html",
          "html"
        ],
        "extensions": [
          ".html"
        ],
        "configuration": "./injection-configuration.json"
      },
      {
        "id": "php",
        "aliases": [
          "php",
          "php"
        ],
        "extensions": [
          ".php"
        ],
        "configuration": "./injection-configuration.json"
      }
    ],
    "grammars": [
      {
        "injectTo": [
          "text.html.derivative"
        ],
        "scopeName": "source.injection.wp-block-html",
        "path": "./syntaxes/html.injection.json"
      },
      {
        "injectTo": [
          "text.html.php"
        ],
        "scopeName": "source.injection.wp-block-html-php",
        "path": "./syntaxes/php.injection.json"
      }
    ],
    "snippets": [
      {
        "language": "html",
        "path": "./snippets.json"
      },
      {
        "language": "php",
        "path": "./snippets.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "node ./out/test/runTest.js"
  },
  "dependencies": {
    "prettier": "^3.8.3",
    "prettier-plugin-wp-block-html": "^0.3.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.120.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^10.4.1",
    "glob": "^13.0.6",
    "mocha": "^11.7.6",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "diff": "^9.0.0",
    "serialize-javascript": "^7.0.5"
  }
}
